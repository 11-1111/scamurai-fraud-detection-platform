# Copy to infra/docker/.env before the first `npm run up`.
#
# These are local development credentials for throwaway containers. Nothing
# here belongs on a real server: generate fresh secrets there and keep them
# out of the repository.

# SQL Server requires at least 8 characters with upper case, lower case, a
# digit and a symbol, or the container exits at startup.
MSSQL_SA_PASSWORD=Scamurai_Local_2026!

# Neo4j rejects passwords shorter than 8 characters.
NEO4J_PASSWORD=scamurai_local_neo4j

REDIS_PASSWORD=scamurai_local_redis

SOURCE_DB_NAME=TransactionsDb
FRAUD_DB_NAME=FraudDb

# Published host ports. Change these if something already holds one.
SQLSERVER_PORT=1433
REDIS_PORT=6379
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
TRANSACTIONS_API_PORT=5289
FRAUD_ENGINE_PORT=4000
BFF_PORT=3000
FRONTEND_PORT=8080

# The API URL the browser uses. Vite inlines it at build time, so changing it
# requires a rebuild rather than a restart.
VITE_API_BASE_URL=http://localhost:3000

# Origins the BFF accepts cross-origin requests from.
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Size of the synthetic dataset created by `npm run up:seed`.
SEED_COUNT=100000
SEED_DAYS=30
